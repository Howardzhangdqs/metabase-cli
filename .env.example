# mbcli configuration.
# Copy to `.env` in the working directory (or export as environment variables).
# Precedence: CLI flags > environment variables > .env > ~/.config/mbcli/config.toml > defaults.

# Metabase instance root URL (required; trailing slash is stripped automatically).
MB_URL=https://metabase.example.com

# API key (Metabase >= v49). If set it takes precedence over username/password
# and no session login is performed.
# MB_API_KEY=mb_xxxxxxxxxxxxxxxx

# Session credentials: used only when MB_API_KEY is unset. They are validated
# lazily, at the first request that needs authentication (`health` works without).
# MB_USERNAME=someone@example.com
# MB_PASSWORD=change-me
